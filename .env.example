BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- PostgreSQL ---
# В docker compose DB_HOST переопределяется на имя сервиса "db".
DB_USER=postgres
DB_PASS=change_me
DB_NAME=news_db
DB_HOST=localhost
DB_PORT=5432

# --- Прочее (все значения опциональны) ---
LOG_LEVEL=INFO
DISPLAY_TZ=UTC
PARSE_COOLDOWN=60
MAX_POSTS=10
REQUEST_TIMEOUT=15
MEDIA_TIMEOUT=30
MAX_MEDIA_BYTES=20971520
DB_ECHO=false
