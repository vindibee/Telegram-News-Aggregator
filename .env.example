# --- Telegram ---
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- PostgreSQL ---
# В docker compose DB_HOST переопределяется на имя сервиса "db".
DB_USER=postgres
DB_PASS=change_me
DB_NAME=news_db
DB_HOST=localhost
DB_PORT=5432

# --- Redis (ограничение частоты и состояния FSM) ---
# В docker compose переопределяется на redis://redis:6379/0.
# Пусто = локальные хранилища в памяти (только для одного экземпляра).
REDIS_URL=
REDIS_PREFIX=newsbot

# --- Ограничение частоты ---
RATE_LIMIT_ENABLED=true
RL_MESSAGE_LIMIT=20
RL_MESSAGE_WINDOW=60
RL_MESSAGE_BURST=5
RL_CALLBACK_LIMIT=30
RL_CALLBACK_WINDOW=60
RL_CALLBACK_BURST=8
RL_REFRESH_LIMIT=1
RL_REFRESH_WINDOW=60
RL_SINGLE_FLIGHT_TTL=10
RL_VIOLATIONS_BEFORE_MUTE=5
RL_VIOLATION_WINDOW=60
RL_WARN_COOLDOWN=10
RL_MUTE_DURATIONS=30,120,600
RL_MUTE_LEVEL_TTL=3600

# --- Биллинг (Telegram Stars) ---
# Provider token не нужен: оплата звёздами идёт внутри Telegram.
INVOICE_TTL_MINUTES=15
MAX_PENDING_INVOICES=3

# --- Трекинг ссылок ---
# Публичный адрес редирект-сервера. Пусто = подмена ссылок отключена.
# Короткие ссылки будут вида https://track.example.com/r/{code}
TRACKER_BASE_URL=
# Срок жизни короткой ссылки в днях; 0 — бессрочно.
TRACKER_LINK_TTL_DAYS=0

# --- Оплата криптовалютой (CryptoBot) ---
# Пусто = раздел скрыт, бот работает на одних звёздах.
# Токен приложения выдаёт @CryptoBot -> Crypto Pay -> Create App.
CRYPTO_BOT_TOKEN=
CRYPTO_BOT_API_URL=https://pay.crypt.bot/api
# Путь должен совпадать с указанным в настройках приложения CryptoBot.
CRYPTO_BOT_WEBHOOK_PATH=/webhook/cryptobot
CRYPTO_BOT_WEBHOOK_HOST=0.0.0.0
CRYPTO_BOT_WEBHOOK_PORT=8080
CRYPTO_BOT_INVOICE_TTL_MINUTES=60
CRYPTO_BOT_TIMEOUT=15

# --- Пробный период ---
TRIAL_ENABLED=true
TRIAL_DAYS=7
# Требовать подтверждение телефона (защита от мультиаккаунтов).
# false отключает защиту — триал сможет получить любой новый аккаунт.
TRIAL_REQUIRE_CONTACT=true
# Обязателен при TRIAL_ENABLED=true и TRIAL_REQUIRE_CONTACT=true.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Менять после запуска нельзя: посчитанные ранее отпечатки перестанут
# совпадать, и каждый пользователь получит право на второй триал.
TRIAL_FINGERPRINT_SECRET=

# --- Фоновый воркер ---
WORKER_EXPIRY_NOTICE_HOURS=24
WORKER_EXPIRY_INTERVAL=900
WORKER_EXPIRATION_INTERVAL=300
WORKER_INVOICE_INTERVAL=600
# Как часто разбирать очередь отложенных публикаций, секунды.
WORKER_PUBLISH_INTERVAL=30
# Как часто переносить переходы из Redis в базу, секунды.
WORKER_CLICK_FLUSH_INTERVAL=60
WORKER_BATCH_SIZE=100

# --- Дедупликация новостей ---
DEDUP_ENABLED=true
DEDUP_HAMMING_THRESHOLD=16
DEDUP_SIMILARITY_THRESHOLD=0.75
DEDUP_SHORT_TEXT_THRESHOLD=0.9
DEDUP_SHORT_TEXT_WORDS=12
DEDUP_LOOKBACK_HOURS=48
DEDUP_CANDIDATE_LIMIT=200

# --- Администрирование, рефералы и рассылка ---
# Telegram ID администраторов через запятую. Нужен для первичной настройки:
# флаг is_admin в базе кто-то должен выставить первым.
ADMIN_IDS=
REFERRAL_BONUS_DAYS=3
# Bot API отбивает поток примерно от 30 сообщений в секунду на бота целиком.
BROADCAST_RATE=25
BROADCAST_WORKERS=8
BROADCAST_PAGE_SIZE=500

# --- Защитный контур ---
# Минимальный интервал между обращениями одного пользователя (скользящее окно).
SECURITY_COOLDOWN=0.5
# Страховка на случай, если процесс умрёт, не сняв блокировку.
SECURITY_LOCK_TTL=30
# Сколько не принимать повтор критического действия после успеха.
SECURITY_ACTION_COOLDOWN=5
# true — при недоступном Redis отказывать в оплате вместо пропуска.
SECURITY_FAIL_CLOSED=false

# --- Прочее (все значения опциональны) ---
LOG_LEVEL=INFO
DISPLAY_TZ=UTC
PARSE_COOLDOWN=60
MAX_POSTS=10
REQUEST_TIMEOUT=15
MEDIA_TIMEOUT=30
MAX_MEDIA_BYTES=20971520
DB_ECHO=false
